# Copy this file to .env and fill in real values. .env is gitignored.

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Groq model name — check https://console.groq.com/docs/models for current availability
GROQ_MODEL=llama-3.1-8b-instant

# Max concurrent in-flight Groq batch requests
GROQ_CONCURRENCY=4

# Clauses per batched Groq call
GROQ_BATCH_SIZE=6
